enum consignaciones_estado {
  en_venta
  vendido
  retirado
}

enum vehiculo_cliente_contexto {
  trade_in
  venta
}

enum historial_mensajes_direccion {
  entrante
  saliente
}

enum chat_estado_clasificacion {
  CALIENTE
  TIBIO
  FRIO
}

enum alertas_stock_tipo {
  km         @map("0km")
  usado
  cualquiera
}

enum autos_tipo {
  km    @map("0km")
  usado
}

enum chat_estado_pago_tipo {
  contado
  financiado
}

enum chat_estado_modalidad_venta {
  venta
  consignacion
}

enum chat_estado_decisor {
  solo
  consulta
}

enum chat_estado_disponibilidad {
  esta_semana
  proximas
  no_sabe
}

enum usuarios_rol {
  admin
