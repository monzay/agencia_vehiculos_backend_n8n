  id                    Int                                    @id @default(autoincrement()) @db.UnsignedInt
  cliente_id            Int                                    @unique(map: "uq_cliente") @db.UnsignedInt
  apellido              String?                                @db.VarChar(120)
  cuit                  String?                                @db.VarChar(11)
  domicilio             String?                                @db.VarChar(200)
  localidad             String?                                @db.VarChar(120)
  provincia             String?                                @db.VarChar(80)
  cbu                   String?                                @db.VarChar(22)
  alias_cbu             String?                                @db.VarChar(40)
  contacto_alt_telefono String?                                @db.VarChar(30)
  contacto_alt_vinculo  cliente_perfiles_contacto_alt_vinculo?
