  updated_at            DateTime                               @default(now()) @db.DateTime(0)
  deleted_at            DateTime?                              @db.DateTime(0)
  clientes              clientes                               @relation(fields: [cliente_id], references: [id], onDelete: Cascade, map: "cliente_perfiles_cliente_fk")
}

