model consignacion_documentos {
  id                    Int                              @id @default(autoincrement()) @db.UnsignedInt
  ingreso_id            Int                              @db.UnsignedInt
  tipo                  consignacion_documentos_tipo
  tenencia              consignacion_documentos_tenencia @default(no_recibido)
  imagenes_json         Json?
  fecha_carga           DateTime                         @default(now()) @db.DateTime(0)
  cargado_por           Int?                             @db.UnsignedInt
  ubicacion_fisica      String?                          @db.VarChar(120)
  fecha_vencimiento     DateTime?                        @db.Date
  datos_json            Json?
  observaciones         String?                          @db.Text
  created_at            DateTime                         @default(now()) @db.DateTime(0)
  updated_at            DateTime                         @default(now()) @db.DateTime(0)
  deleted_at            DateTime?                        @db.DateTime(0)
  consignacion_ingresos consignacion_ingresos            @relation(fields: [ingreso_id], references: [id], onDelete: Cascade, map: "consignacion_documentos_ingreso_fk")
  usuarios              usuarios?                        @relation(fields: [cargado_por], references: [id], map: "consignacion_documentos_usuario_fk")

  @@index([cargado_por], map: "consignacion_documentos_usuario_fk")
  @@index([ingreso_id, tipo, deleted_at], map: "idx_ingreso")
  @@index([deleted_at, fecha_vencimiento], map: "idx_vencimiento")
  @@index([deleted_at, tenencia], map: "idx_tenencia")
}

