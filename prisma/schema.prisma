generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model alertas_stock {
  id          Int                 @id @default(autoincrement()) @db.UnsignedInt
  cliente_id  Int                 @db.UnsignedInt
  presupuesto Decimal?            @db.Decimal(12, 2)
  uso         String?             @db.VarChar(60)
  tipo        alertas_stock_tipo? @default(cualquiera)
  notificado  Boolean             @default(false)
  created_at  DateTime?           @default(now()) @db.DateTime(0)
  clientes    clientes            @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "alertas_stock_ibfk_1")

  @@index([cliente_id], map: "cliente_id")
}

model autos {
  id               Int                @id @default(autoincrement()) @db.UnsignedInt
  ref              String             @unique(map: "ref") @db.VarChar(30)
  marca            String             @db.VarChar(60)
  modelo           String             @db.VarChar(80)
  anio             Int                @db.UnsignedSmallInt
  tipo             autos_tipo
  tipo_vehiculo    String?            @db.VarChar(10)
  combustible      String?            @db.VarChar(10)
  precio           Decimal            @db.Decimal(12, 2)
  costo            Decimal?           @db.Decimal(12, 2)
  precio_venta     Decimal?           @db.Decimal(12, 2)
  vendido_at       DateTime?          @db.DateTime(0)
  kms              Int?               @default(0) @db.UnsignedInt
  stock            Int                @default(1) @db.UnsignedSmallInt
  descripcion      String?            @db.Text
  fotos_json       Json?
  disponible       Boolean            @default(true)
  uso              String?
  created_at       DateTime?          @default(now()) @db.DateTime(0)
  updated_at       DateTime?          @default(now()) @db.DateTime(0)
  deleted_at       DateTime?          @db.DateTime(0)
  descuento_id     Int?               @db.UnsignedInt
  auto_promociones auto_promociones[]
  auto_vistas      auto_vistas[]
  descuentos       descuentos?        @relation(fields: [descuento_id], references: [id], onUpdate: NoAction, map: "autos_descuento_fk")
  consignaciones   consignaciones[]

  @@index([disponible], map: "idx_disponible")
  @@index([precio], map: "idx_precio")
  @@index([tipo], map: "idx_tipo")
  @@index([descuento_id], map: "idx_descuento")
  @@index([vendido_at], map: "idx_vendido")
}

model chat_estado {
  id               Int                          @id @default(autoincrement()) @db.UnsignedInt
  cliente_id       Int                          @db.UnsignedInt
  paso_actual      String                       @default("gw_router") @db.VarChar(60)
  score            Int                          @default(0) @db.UnsignedTinyInt
  clasificacion    chat_estado_clasificacion?
  alerta_enviada   Boolean                      @default(false)
  pago_tipo        chat_estado_pago_tipo?
  anticipo         String?                      @db.VarChar(40)
  cuotas           Int?                         @db.UnsignedTinyInt
  credito_ok       Int?                         @db.TinyInt
  entrega_usado    Boolean?
  decisor          chat_estado_decisor?
  decisor_con      String?                      @db.VarChar(40)
  disponibilidad   chat_estado_disponibilidad?
  auto_id          Int?                         @db.UnsignedInt
  origen           String?                      @db.VarChar(20)
  vendedor_id      Int?                         @db.UnsignedInt
  atribuido        Boolean                      @default(false)
  bot_pausado      Boolean                      @default(false)
  atendido_at      DateTime?                    @db.DateTime(0)
  atendido_por     String?                      @db.VarChar(120)
  opt_out          Boolean                      @default(false)
  retry_count      Int                          @default(0) @db.UnsignedTinyInt
  unknown_count    Int                          @default(0) @db.UnsignedTinyInt
  seg_execution_id String?                      @db.VarChar(120)
  abandonado_en    DateTime?                    @db.DateTime(0)
  abandono_paso    String?                      @db.VarChar(60)
  ultimo_mensaje   DateTime?                    @db.DateTime(0)
  sesion_inicio    DateTime?                    @default(now()) @db.DateTime(0)
  updated_at       DateTime?                    @default(now()) @db.DateTime(0)
  recordatorio_en  DateTime?                    @db.DateTime(0)
  tipo_lead        String?                      @db.VarChar(20)
  modalidad_venta  chat_estado_modalidad_venta?
  nombre_declarado String?                      @db.VarChar(120)
  clientes         clientes                     @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chat_estado_ibfk_1")
  vehiculo_cliente vehiculo_cliente[]

  @@index([cliente_id], map: "idx_cliente")
  @@index([opt_out], map: "idx_opt_out")
  @@index([paso_actual], map: "idx_paso")
  @@map("sesiones")
}

model vehiculo_cliente {
  id            Int                       @id @default(autoincrement()) @db.UnsignedInt
  sesion_id     Int                       @db.UnsignedInt
  contexto      vehiculo_cliente_contexto
  marca         String?                   @db.VarChar(60)
  modelo        String?                   @db.VarChar(60)
  anio          Int?                      @db.UnsignedSmallInt
  kms           String?                   @db.VarChar(40)
  precio_pedido String?                   @db.VarChar(40)
  created_at    DateTime?                 @default(now()) @db.DateTime(0)
  updated_at    DateTime?                 @default(now()) @db.DateTime(0)
  deleted_at    DateTime?                 @db.DateTime(0)
  chat_estado   chat_estado               @relation(fields: [sesion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "vehiculo_cliente_ibfk_1")

  @@unique([sesion_id, contexto], map: "uq_sesion_contexto")
  @@index([sesion_id], map: "idx_sesion")
}

model clientes {
  id                    Int                     @id @default(autoincrement()) @db.UnsignedInt
  nombre                String?                 @db.VarChar(120)
  telefono              String?                 @db.VarChar(30)
  dni                   String?                 @db.VarChar(20)
  email                 String?                 @db.VarChar(180)
  canal                 clientes_canal
  canal_id              String                  @db.VarChar(120)
  created_at            DateTime?               @default(now()) @db.DateTime(0)
  alertas_stock         alertas_stock[]
  cliente_perfiles      cliente_perfiles?
  ingresos_como_titular consignacion_ingresos[] @relation("consignacion_ingresos_cliente_idToclientes")
  ingresos_como_conyuge consignacion_ingresos[] @relation("consignacion_ingresos_conyuge_cliente_idToclientes")
  financiaciones        financiaciones[]
  historial_mensajes    historial_mensajes[]
  chat_estado           chat_estado[]

  @@unique([canal, canal_id], map: "uq_canal")
}

model financiaciones {
  id              Int                  @id @default(autoincrement()) @db.UnsignedInt
  cliente_id      Int                  @db.UnsignedInt
  cantidad_cuotas Int                  @db.UnsignedSmallInt
  precio_cuota    Decimal              @db.Decimal(12, 2)
  dia_pago        Int                  @db.UnsignedTinyInt
  telefono_alt    String?              @db.VarChar(30)
  activo          Boolean              @default(true)
  created_at      DateTime?            @default(now()) @db.DateTime(0)
  updated_at      DateTime?            @default(now()) @db.DateTime(0)
  deleted_at      DateTime?            @db.DateTime(0)
  pagos           financiacion_pagos[]
  clientes        clientes             @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "financiaciones_ibfk_1")

  @@index([cliente_id], map: "idx_cliente")
  @@index([activo], map: "idx_activo")
}

model financiacion_pagos {
  id              Int            @id @default(autoincrement()) @db.UnsignedInt
  financiacion_id Int            @db.UnsignedInt
  numero          Int            @db.UnsignedSmallInt
  pagado_en       DateTime?      @default(now()) @db.DateTime(0)
  created_at      DateTime?      @default(now()) @db.DateTime(0)
  financiaciones  financiaciones @relation(fields: [financiacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "financiacion_pagos_ibfk_1")

  @@unique([financiacion_id, numero], map: "uq_financiacion_numero")
  @@index([financiacion_id], map: "idx_financiacion")
}

model historial_mensajes {
  id         BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  cliente_id Int                          @db.UnsignedInt
  direccion  historial_mensajes_direccion
  mensaje    String?                      @db.Text
  paso_nodo  String?                      @db.VarChar(60)
  created_at DateTime?                    @default(now()) @db.DateTime(0)
  clientes   clientes                     @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "historial_mensajes_ibfk_1")

  @@index([cliente_id, created_at], map: "idx_cliente_ts")
  @@index([direccion, created_at], map: "idx_direccion_ts")
}

model leads_pendientes {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  canal      String?   @db.VarChar(30)
  canal_id   String?   @db.VarChar(120)
  payload    Json?
  created_at DateTime? @default(now()) @db.DateTime(0)
  procesado  Boolean   @default(false)
}

model vendedores {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  nombre           String    @db.VarChar(120)
  slug             String?   @unique(map: "uq_vendedores_slug") @db.VarChar(40)
  telefono         String?   @db.VarChar(30)
  telegram_id      String?   @db.VarChar(60)
  email            String?   @db.VarChar(180)
  activo           Boolean   @default(true)
  recibe_consultas Boolean   @default(true)
  leads_activos    Int       @default(0) @db.UnsignedInt
  calendar_id      String?   @db.VarChar(200)
  created_at       DateTime? @default(now()) @db.DateTime(0)
  updated_at       DateTime? @default(now()) @db.DateTime(0)
  deleted_at       DateTime? @db.DateTime(0)

  @@index([activo, leads_activos], map: "idx_activo_leads")
}

model usuarios {
  id                      Int                       @id @default(autoincrement()) @db.UnsignedInt
  nombre                  String                    @db.VarChar(120)
  email                   String                    @db.VarChar(180)
  password_hash           String                    @db.VarChar(255)
  rol                     usuarios_rol              @default(asesor)
  activo                  Boolean                   @default(true)
  admin_unico             Int?                      @unique(map: "uq_admin_unico") @db.UnsignedTinyInt
  vendedor_id             Int?                      @db.UnsignedInt
  created_at              DateTime?                 @default(now()) @db.DateTime(0)
  updated_at              DateTime?                 @default(now()) @db.DateTime(0)
  consultas_visto_at      DateTime?                 @db.DateTime(0)
  ventas_visto_at         DateTime?                 @db.DateTime(0)
  financiacion_visto_at   DateTime?                 @db.DateTime(0)
  descuentos_visto_at     DateTime?                 @db.DateTime(0)
  clientes_visto_at       DateTime?                 @db.DateTime(0)
  deleted_at              DateTime?                 @db.DateTime(0)
  consignacion_documentos consignacion_documentos[]
  consignacion_ingresos   consignacion_ingresos[]

  @@index([email], map: "idx_email")
  @@index([rol], map: "idx_rol")
}

model descuentos {
  id                     Int             @id @default(autoincrement()) @db.UnsignedInt
  nombre                 String          @db.VarChar(120)
  tipo                   descuentos_tipo @default(porcentaje)
  valor                  Decimal         @db.Decimal(12, 2)
  fecha_fin              DateTime?       @db.DateTime(0)
  vencimiento_avisado_at DateTime?       @db.DateTime(0)
  activo                 Boolean         @default(true)
  created_at             DateTime?       @default(now()) @db.DateTime(0)
  updated_at             DateTime?       @default(now()) @db.DateTime(0)
  deleted_at             DateTime?       @db.DateTime(0)
  autos                  autos[]

  @@index([activo], map: "idx_activo")
}

model auto_promociones {
  auto_id      Int         @db.UnsignedInt
  promocion_id Int         @db.UnsignedInt
  created_at   DateTime?   @default(now()) @db.DateTime(0)
  autos        autos       @relation(fields: [auto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auto_promo_auto_fk")
  promociones  promociones @relation(fields: [promocion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auto_promo_promo_fk")

  @@id([auto_id, promocion_id])
  @@index([promocion_id], map: "idx_promo")
}

model promociones {
  id                     Int                         @id @default(autoincrement()) @db.UnsignedInt
  nombre                 String                      @db.VarChar(120)
  descripcion            String                      @db.Text
  condiciones            String?                     @db.Text
  descuento              Decimal?                    @db.Decimal(12, 2)
  descuento_tipo         promociones_descuento_tipo?
  fecha_fin              DateTime?                   @db.DateTime(0)
  vencimiento_avisado_at DateTime?                   @db.DateTime(0)
  activo                 Boolean                     @default(true)
  created_at             DateTime?                   @default(now()) @db.DateTime(0)
  updated_at             DateTime?                   @default(now()) @db.DateTime(0)
  deleted_at             DateTime?                   @db.DateTime(0)
  auto_promociones       auto_promociones[]

  @@index([activo], map: "idx_activo")
}

model configuracion {
  clave      String    @id @db.VarChar(60)
  valor      String?   @db.VarChar(255)
  updated_at DateTime? @default(now()) @db.DateTime(0)
}

model consignaciones {
  id                    Int                    @id @default(autoincrement()) @db.UnsignedInt
  auto_id               Int                    @db.UnsignedInt
  patente               String?                @db.VarChar(15)
  duenio_nombre         String                 @db.VarChar(120)
  duenio_telefono       String?                @db.VarChar(30)
  precio_pactado        Decimal                @db.Decimal(12, 2)
  comision              Decimal                @default(0.00) @db.Decimal(5, 2)
  estado                consignaciones_estado  @default(en_venta)
  notas                 String?                @db.Text
  created_at            DateTime               @default(now()) @db.DateTime(0)
  updated_at            DateTime               @default(now()) @db.DateTime(0)
  deleted_at            DateTime?              @db.DateTime(0)
  consignacion_ingresos consignacion_ingresos?
  autos                 autos                  @relation(fields: [auto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "consignaciones_auto_fk")

  @@index([estado], map: "idx_estado")
  @@index([deleted_at, estado], map: "idx_vigentes")
  @@index([auto_id], map: "idx_auto")
}

model entregas {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  url        String    @db.VarChar(500)
  created_at DateTime  @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  @@index([deleted_at, id], map: "idx_vigentes")
}

model ubicacion {
  id         Int      @id @default(1) @db.UnsignedTinyInt
  nombre     String   @db.VarChar(120)
  direccion  String   @db.VarChar(200)
  maps_url   String?  @db.VarChar(500)
  latitud    Decimal? @db.Decimal(10, 7)
  longitud   Decimal? @db.Decimal(10, 7)
  updated_at DateTime @default(now()) @db.DateTime(0)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model horarios_atencion {
  dia        Int      @id @db.UnsignedTinyInt
  abierto    Boolean  @default(true)
  apertura   String?  @db.Char(5)
  cierre     String?  @db.Char(5)
  updated_at DateTime @default(now()) @db.DateTime(0)
}

model auto_vistas {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  auto_id    Int       @db.UnsignedInt
  created_at DateTime? @default(now()) @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)
  autos      autos     @relation(fields: [auto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auto_vistas_ibfk_1")

  @@index([auto_id, created_at], map: "idx_auto_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
