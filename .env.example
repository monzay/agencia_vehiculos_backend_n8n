# Plantilla de variables de entorno. Copiar a .env en el servidor y completar.
# NO poner valores reales aca (este archivo si se sube a git).

# Base de datos (Aiven MySQL). En el server la ruta del CA es la del contenedor.
DATABASE_URL="mysql://avnadmin:PASSWORD@mysql-313d9fe5-agenciaautomatizacion1.j.aivencloud.com:26884/agencia?sslaccept=strict&sslcert=/app/prisma/aiven-ca.pem"

# Puerto interno de la API
PORT=4000

# Origenes permitidos para CORS (dominios del front en produccion, separados por coma)
CORS_ORIGIN="https://tudominio.com"

# Secreto para firmar los JWT. Generar uno largo y aleatorio en el server.
JWT_SECRET="CAMBIAR_POR_UNO_ALEATORIO_LARGO"
JWT_EXPIRES="8h"
